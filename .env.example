# Copy this file to .env for local development.
# On Render/Railway/etc, set these as environment variables in the dashboard instead.

# PostgreSQL connection string. Get this from Neon, Supabase, Render, Railway, etc.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Any long random string (used to sign admin login sessions).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Generate with: node hash-password.js "your-chosen-admin-password"
ADMIN_PASSWORD_HASH=

# Optional, defaults to 3000. Most hosts set this automatically.
PORT=3000
